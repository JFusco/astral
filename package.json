{
  "name": "astral-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "node scripts/copy-ui-fonts.mjs && tailwindcss -i frontend/styles/app.css -o dist/app.css --minify",
    "dev:css": "tailwindcss -i frontend/styles/app.css -o dist/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
