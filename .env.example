# Copy to .env on the server. Never paste keys into chat or the dashboard.
# Modes use separate databases. No live-trading mode exists.
ASTRAL_MODE=alpaca
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# Start read-only; enable after account/assets/quotes/reconciliation are healthy.
ASTRAL_ENABLE_PAPER_ORDERS=false
ASTRAL_EQUITY_FEED=iex
# News requires a verified account entitlement. No silent free-feed assumption.
ASTRAL_ENABLE_NEWS=false
# Read-only risk probes; cannot be combined with enabled order submission.
ASTRAL_ENABLE_SHADOW=false
# Daily history screening; news entitlement and event calendars remain explicit.
ASTRAL_ENABLE_RESEARCH=false
# Uses existing Codex CLI sign-in. Sol High; maximum 4 attempts/day, 180s each.
ASTRAL_ENABLE_CODEX_RESEARCH=false
# Local conditional exits are not broker-native protective stops; explicit opt-in.
ASTRAL_ENABLE_EXIT_MONITOR=false

# To exercise the persistent simulator WITHOUT contacting Alpaca:
# ASTRAL_MODE=simulator
# ASTRAL_ENABLE_PAPER_ORDERS=true
